# --- Application ---
PRISM_ENV=dev
PRISM_SECRET_KEY=change-me
PRISM_LOG_LEVEL=INFO

# --- Database (Postgres + pgvector) ---
DATABASE_URL=postgresql+psycopg://prism:prism@127.0.0.1:5434/prism

# --- Redis / worker ---
REDIS_URL=redis://localhost:6379/0

# --- LLM (Ollama by default; OpenAI-compatible optional) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:4b
# OPENAI_API_BASE=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=

# --- RAG defaults ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNKING_STRATEGY=C2
CHUNK_SIZE=256
CHUNK_OVERLAP=32
TOP_K=5
RETRIEVAL_MODE=dense
SPACE_DEFAULT=personal
SPACE_WEIGHTS_ENABLED=true
SPACE_WEIGHT_PERSONAL=1.0
SPACE_WEIGHT_PROJECT=0.85
SPACE_WEIGHT_SHARED=0.72

# --- LLM extras ---
LLM_CACHE_ENABLED=true
LLM_PII_REDACT=true
LLM_INPUT_USD_PER_1M=0.0
LLM_OUTPUT_USD_PER_1M=0.0
APPROVAL_TTL_SECONDS=300

# --- Observability (Stage 5) ---
OTEL_ENABLED=false
OTEL_SERVICE_NAME=prism
# OTEL_EXPORTER_ENDPOINT=http://localhost:4317

# --- Stage 6 product ---
WEB_SEARCH_MOCK=true
DISTILL_ENABLED=true


# --- Upload storage ---
UPLOAD_DIR=./data/uploads
BM25_DIR=./data/bm25
